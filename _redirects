# Force everything to a single canonical host: https://nszgoaride.com
# Netlify processes these top-to-bottom; "!" forces the rule even if a
# file/route would otherwise match, and each rule is a direct 301 to the
# final URL (no chaining through an intermediate host).

http://nszgoaride.com/*        https://nszgoaride.com/:splat   301!
http://www.nszgoaride.com/*    https://nszgoaride.com/:splat   301!
https://www.nszgoaride.com/*   https://nszgoaride.com/:splat   301!

# Keep the extensionless policy URL aligned with the existing directory page.
/privacy-policy   /privacy-policy/   301
